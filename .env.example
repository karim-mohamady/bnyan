# ===================================================
# Bnyan Web App - Next.js Environment Variables Template
# ===================================================

# رابط الواجهة الأمامية والدومين الرئيسي للموقع
NEXT_PUBLIC_SITE_URL=https://bunyankh.org.sa
NEXT_PUBLIC_API_URL=https://bunyankh.org.sa

# رابط الـ Backend / API (Laravel) في بيئة الإنتاج
LARAVEL_API_URL=https://api.bunyankh.org.sa/api/v1
NEXT_PUBLIC_API_BASE_URL=https://api.bunyankh.org.sa/api/v1

# سر التحديث الفوري (يجب أن يطابق القيمة في laravel/.env)
REVALIDATE_SECRET=your_production_revalidate_secret_here

# رابط الـ Revalidate المستهدف من Laravel
NEXT_REVALIDATE_URL=https://bunyankh.org.sa/api/revalidate