# ── Next.js (public website) ─────────────────────────────────────────
# Laravel dashboard API. Leave EMPTY to run the website on its built-in static data only.
# Example: http://127.0.0.1:8000/api/v1   or   https://api.your-domain.com/api/v1
LARAVEL_API_URL=

# Public address of the website (used for sitemap / robots / SEO)
NEXT_PUBLIC_SITE_URL=https://bnyan.org.sa

# Shared secret used by the dashboard to refresh the website after every save.
# MUST be identical to REVALIDATE_SECRET in laravel/.env — use a long random string.
REVALIDATE_SECRET=
