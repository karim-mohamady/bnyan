{
    "name": "bnyan/backend",
    "type": "project",
    "description": "Backend API and Admin Dashboard for Bnyan Association",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
    "audit": {
    "block-insecure": false
    },
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
